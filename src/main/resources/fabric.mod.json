{
  "schemaVersion": 1,
  "id": "omwh",
  "version": "${version}",
  "name": "OMWH",
  "description": "Server-side /home and /spawn commands that use Minecraft's existing home and world-spawn destinations and bring mounted vehicles and passengers with you.",
  "authors": [
    "PyreHaven"
  ],
  "contact": {
    "homepage": "https://pyrehaven.xyz",
    "sources": "https://github.com/ff-tech-xyz/omwh",
    "issues": "https://github.com/ff-tech-xyz/omwh/issues"
  },
  "icon": "assets/omwh/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "xyz.pyrehaven.omwh.Omwh"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=21",
    "fabric-api": "*"
  }
}
